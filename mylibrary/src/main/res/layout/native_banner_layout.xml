<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Meta Native Banner template: icon + title/sponsored + CTA, no media.
     Colors default to the light gnt_* palette; the host can override text/bg at
     runtime via NativeAdStyle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/gnt_white"
    android:padding="8dp">

    <com.facebook.ads.MediaView
        android:id="@+id/native_banner_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/native_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/gnt_black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/native_banner_sponsored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#757575"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/native_banner_adchoices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/native_banner_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/gnt_white"
        android:textSize="12sp"
        android:background="#4286F4"
        android:textAllCaps="false" />
</LinearLayout>
