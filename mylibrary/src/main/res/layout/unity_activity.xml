<?xml version="1.0" encoding="utf-8"?>
<!-- FIX 1: xmlns:app removed — was declared but never used -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- FIX 2: android:id added to content area -->
    <RelativeLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/banner_container">

        <!-- FIX 3: hardcoded text → @string resource -->
        <Button
            android:id="@+id/showInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="20dp"
            android:text="@string/show_interstitial" />

        <LinearLayout
            android:id="@+id/native_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/showInterstitial"
            android:orientation="vertical" />

    </RelativeLayout>

    <!-- FIX 4: com.demo.adslibsss.Adlib.view.BannerAdView → FrameLayout
         OLD class does not exist in new architecture — would crash at inflate time.
         Use FrameLayout as a banner container; add AdView programmatically. -->
    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center" />

</RelativeLayout>
