<!-- FIX 1: android:orientation="vertical" removed from root RelativeLayout — orientation
     attribute is only valid on LinearLayout; it is silently ignored on RelativeLayout -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <!-- FIX 2: match_parent height inside wrap_content CardView → wrap_content
             match_parent here resolves to 0px since CardView height is wrap_content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/ttl"
                android:layout_width="match_parent"
                android:layout_height="80dp">

                <!-- FIX 3: textSize 30dp → 30sp (dp ignores user font-size accessibility setting) -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:textColor="@color/gnt_blue"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ScrollView
                android:id="@+id/scrollll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ttl">

                <!-- FIX 4: android:layout_gravity="center" removed — invalid on child
                     of ScrollView (ScrollView is a FrameLayout, but gravity here does nothing
                     on the direct child which fills the scroll area) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:padding="10dp">

                    <!-- FIX 5: textSize 16dp → 16sp -->
                    <!-- FIX 6: paddingLeft/Right → paddingStart/End for RTL support -->
                    <TextView
                        android:id="@+id/title1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAlignment="center"
                        android:textColor="@color/gnt_blue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_below="@+id/title1"
                        android:layout_marginTop="30dp"
                        android:clipToPadding="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="100">

                        <!-- FIX 7: layout_marginLeft/Right → marginStart/End for RTL -->
                        <Button
                            android:id="@+id/Btn_Yes"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="33"
                            android:background="@drawable/curved_shape"
                            android:textAllCaps="false"
                            android:textColor="#ffffff"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="33">

                            <Button
                                android:id="@+id/Btn_Rate"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/curved_shape"
                                android:textAllCaps="false"
                                android:textColor="#ffffff"
                                android:textStyle="bold" />

                            <!-- FIX 8: textSize 7dp → 8sp (minimum readable size + sp unit) -->
                            <!-- FIX 9: layout_alignParentRight → layout_alignParentEnd for RTL -->
                            <!-- FIX 10: layout_marginRight → layout_marginEnd for RTL -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="5dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/ad_curved_shape"
                                android:text="Ad"
                                android:textColor="@color/gnt_white"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <Button
                            android:id="@+id/Btn_No"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="33"
                            android:background="@drawable/curved_shape"
                            android:textAllCaps="false"
                            android:textColor="#ffffff"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </ScrollView>

            <!-- FIX 11: Conflicting layout_below + layout_alignParentBottom removed.
                 layout_below pushes this below scrollll; layout_alignParentBottom independently
                 pins to parent bottom — both together cause unpredictable position.
                 Keeping only layout_below so it sits naturally after scroll content. -->
            <RelativeLayout
                android:id="@+id/banner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/scrollll">

                <pl.droidsonroids.gif.GifImageView
                    android:id="@+id/gifImageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/banner"
                    android:layout_centerInParent="true"
                    android:padding="50dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thankyou" />

                <RelativeLayout
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center" />
            </RelativeLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
