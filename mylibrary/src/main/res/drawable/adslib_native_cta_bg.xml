<?xml version="1.0" encoding="utf-8"?>
<!-- Blue CTA pill (app accent) with a subtle top-to-bottom gradient for depth.
     Tinted by NativeAdStyle.ctaBackgroundColor at runtime (shape is preserved
     via backgroundTintList) so it can match the host app's exact accent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/adslib_nb_cta_start"
        android:endColor="@color/adslib_nb_cta_end" />
</shape>
