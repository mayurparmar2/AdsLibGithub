<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Content area — fills all space above the bottom banner slot -->
    <RelativeLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/banner1"
        android:background="@color/black">

        <LinearLayout
            android:id="@+id/btn_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <Button
                android:id="@+id/showInterstitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_interstitial" />

            <Button
                android:id="@+id/showRewarded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/show_rewarded" />

        </LinearLayout>

        <!-- Inline banner container (programmatically filled by loadBanner()) -->
        <LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_group"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Native ad container (programmatically filled when NativeAdManager is added) -->
        <LinearLayout
            android:id="@+id/native_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/banner_container"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </RelativeLayout>

    <!-- Bottom banner slot — FrameLayout is correct for a single programmatic AdView child -->
    <FrameLayout
        android:id="@+id/banner1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center" />

</RelativeLayout>
