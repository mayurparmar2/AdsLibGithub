<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <!-- Content area — fills space above bottom banner -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/banner_bottom"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="Initializing ads..."
                android:textColor="#aaaaaa"
                android:textSize="13sp" />

            <!-- ── Fullscreen Ad Buttons ─────────────────────── -->

            <Button
                android:id="@+id/showInterstitial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#e94560"
                android:text="@string/show_interstitial"
                android:textColor="#ffffff"
                android:textStyle="bold" />

            <Button
                android:id="@+id/showRewarded"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#0f3460"
                android:text="@string/show_rewarded"
                android:textColor="#ffffff"
                android:textStyle="bold" />

            <Button
                android:id="@+id/showNative"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#16213e"
                android:text="@string/show_native"
                android:textColor="#ffffff"
                android:textStyle="bold" />

            <!-- ── Inline Banner (below buttons) ─────────────── -->

            <LinearLayout
                android:id="@+id/banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical" />

            <!-- ── Native Ad slot ────────────────────────────── -->

            <LinearLayout
                android:id="@+id/native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom adaptive banner (always visible) -->
    <FrameLayout
        android:id="@+id/banner_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:gravity="center" />

</RelativeLayout>
